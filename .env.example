# Scrape-Tupe Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# ── Master (local SQLite development only) ───────────────
MASTER_ADDR=:8080
MASTER_DB=scrape-tupe.db

# ── Downloader ──────────────────────────────────────────
MASTER_URL=http://localhost:8080
WORKER_ID=
OUTPUT_DIR=/tmp/scrape-tupe/downloads

# ── Storage ──────────────────────────────────────────────
# noop is suitable for local worker testing. For Cloud Run Jobs, use gcs and
# grant the downloader service account storage.objects.create on GCS_BUCKET.
STORAGE_BACKEND=noop
GCS_BUCKET=
# Used only with STORAGE_BACKEND=local (tests/local development).
LOCAL_STORAGE_DIR=

# ── Downloader behavior ─────────────────────────────────
CLEANUP_TEMP=true
# Cloud Run Job tasks must stop once the queue is drained.
EXIT_WHEN_EMPTY=false
